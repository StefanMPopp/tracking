averaging_method = mode
detect_size_filter = [[300,20000]]
track_size_filter = [[300,20000]]
use_adaptive_threshold = false
blob_split_algorithm = none
detect_threshold = 106
detect_type = background_subtraction
use_closing = false
closing_size = 3
dilation_size = 0
meta_encoding = rgb8
meta_real_width = 10.2
track_background_subtraction = true
track_max_individuals = 10
track_threshold = 50
track_max_speed = 5000
match_min_probability = 0.05
track_max_reassign_time = 10
track_history_split_threshold = 200
video_conversion_range = [60,200]
output_fields = [["timestamp",[]],["X",["RAW","WCENTROID"]],["Y",["RAW","WCENTROID"]],["midline_length",["RAW"]],["missing",[]],["blob_height",["RAW","WCENTROID"]],["blob_width",["RAW","WCENTROID"]],["num_pixels",["RAW","WCENTROID"]]]
auto_quit = true
nowindow = true
auto_no_results = true
output_format = csv
individual_prefix = ant
