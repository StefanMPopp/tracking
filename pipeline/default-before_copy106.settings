averaging_method = mode
detect_size_filter = [[100,14000]]
track_size_filter = [[100,14000]]
blob_split_global_shrink_limit = 0.9
blob_split_max_shrink = 0.9
use_closing = true
closing_size = 5
dilation_size = 2
use_closing = true
closing_size = 5
track_do_history_split = false
use_adaptive_threshold = false
blob_split_algorithm = none
detect_threshold = 40
detect_type = background_subtraction
meta_encoding = rgb8
meta_real_width = 24.5
track_background_subtraction = true
track_max_individuals = 8
track_threshold = 90
track_max_speed = 400
track_history_split_threshold = 50
match_min_probability = 0.05
track_max_reassign_time = 10
video_conversion_range = [30,900]
