averaging_method = mode
cm_per_pixel = 1
detect_size_filter = [[90,24000]]
track_size_filter = [[90,20000]]
blob_split_global_shrink_limit = 0.9
blob_split_max_shrink = 0.9
use_closing = true
closing_size = 6
use_adaptive_threshold = false
blob_split_algorithm = none
detect_threshold = 30
dilation_size = 1
detect_type = background_subtraction
meta_encoding = rgb8
meta_real_width = 3840
track_background_subtraction = true
track_max_individuals = 8
track_threshold = 3
track_max_speed = 4000
match_min_probability = 0.05
track_max_reassign_time = 10
video_conversion_range = [0,150]
output_fields = [["X",["RAW","WCENTROID"]],["Y",["RAW","WCENTROID"]],["midline_length",["RAW"]],["missing",[]],["blob_height",["RAW","WCENTROID"]],["blob_width",["RAW","WCENTROID"]],["num_pixels",["RAW","WCENTROID"]]]
auto_quit = true
nowindow = true
auto_no_results = true
output_format = csv
individual_prefix = ant
